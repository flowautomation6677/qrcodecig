// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id              String    @id @default(uuid())
  instanceName    String
  messageMode     String    @default("text") // text, image, audio
  messageTemplate String
  
  // Media fields
  mediaBase64     String?
  mediaUrl        String?
  fileName        String?
  isPtt           Boolean   @default(true)
  
  // Cadence
  delayMin        Int       @default(15)
  delayMax        Int       @default(45)
  batchSize       Int       @default(40)
  batchPause      Int       @default(10)
  
  // Scheduling & Status
  status          String    @default("pending") // pending, scheduled, running, paused, completed
  scheduledAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts        Contact[]
}

model Contact {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  number      String
  name        String?
  
  status      String    @default("pending") // pending, checking, typing, recording, sent, failed
  error       String?
  
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
}
