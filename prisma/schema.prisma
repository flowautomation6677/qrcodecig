// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  
  campaigns Campaign[]
}

model Client {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  instanceName String     @unique
  phoneNumber  String?
  status       String     @default("disconnected") // connected, disconnected, connecting
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  campaigns    Campaign[]
}

model Campaign {
  id              String    @id @default(uuid())
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String    @default("Nova Campanha")
  instanceName    String
  messageMode     String    @default("text") // text, image, audio, video
  messageTemplate String
  
  // Media fields
  mediaBase64     String?
  mediaUrl        String?
  fileName        String?
  isPtt           Boolean   @default(true)
  
  // Cadence
  delayMin        Int       @default(15)
  delayMax        Int       @default(45)
  batchSize       Int       @default(40)
  batchPause      Int       @default(10)
  
  // Scheduling & Status
  status          String    @default("pending") // pending, scheduled, running, paused, completed
  scheduledAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts        Contact[]
}

model Contact {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  number      String
  name        String?
  
  status      String    @default("pending") // pending, checking, typing, recording, sent, failed
  error       String?
  
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
}
